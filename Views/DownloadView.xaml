<UserControl x:Class="HyperLisUI.Views.DownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HyperLisUI.Views"
             xmlns:components="clr-namespace:HyperLisUI.Views.Components"
             xmlns:helpers="clr-namespace:HyperLisUI.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="900"
             TextOptions.TextFormattingMode="Display"
             Loaded="DownloadView_Loaded"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <!-- Horizontal ScrollViewer Style for App Lists -->
        <Style x:Key="HorizontalScrollViewer" TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="PanningMode" Value="HorizontalOnly"/>
        </Style>



        <!-- Style for the Inner Horizontal ListBox -->
        <Style x:Key="HorizontalAppListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <StackPanel>
                            <ScrollViewer x:Name="PART_ScrollViewer" 
                                          CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                          Focusable="False"
                                          MinHeight="165"
                                          helpers:ScrollViewerBinding.MonitorScroll="True">
                                <ItemsPresenter/>
                            </ScrollViewer>

                            <!-- Custom Scrollbar (Slider) -->
                            <Slider Maximum="{Binding ScrollableWidth, ElementName=PART_ScrollViewer}"
                                    Value="{Binding (helpers:ScrollViewerBinding.HorizontalOffset), ElementName=PART_ScrollViewer}"
                                    Margin="10,0,45,0"
                                    HorizontalAlignment="Stretch"
                                    Focusable="False">
                                <Slider.Style>
                                    <Style TargetType="Slider">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Slider">
                                                    <Grid>
                                                        <Border Name="TrackBackground" Background="Transparent" Height="14" VerticalAlignment="Center"/>
                                                        <Track x:Name="PART_Track">
                                                            <Track.Thumb>
                                                                <Thumb>
                                                                    <Thumb.Template>
                                                                        <ControlTemplate TargetType="Thumb">
                                                                            <Border Width="50" Height="11" Background="#A6A6A6" CornerRadius="6"/>
                                                                        </ControlTemplate>
                                                                    </Thumb.Template>
                                                                </Thumb>
                                                            </Track.Thumb>
                                                        </Track>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ScrollableWidth, ElementName=PART_ScrollViewer}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Slider.Style>
                            </Slider>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Buttons -->
            <RowDefinition Height="*"/>    <!-- Main Content -->
        </Grid.RowDefinitions>

        <!-- Top Action Buttons -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,20,10">
            <Button x:Name="btnInstallSelected" Content="Install Selected" Click="InstallSelected_Click" Style="{StaticResource ActionButtonStyle}" Margin="5,0" Width="Auto" MinWidth="160" Padding="15,12" FontSize="15" Background="#A078C0E0"/>
            <Button x:Name="btnUninstallSelected" Content="Uninstall Selected" Click="UninstallSelected_Click" Style="{StaticResource ActionButtonStyle}" Margin="5,0" Width="Auto" MinWidth="160" Padding="15,12" FontSize="15" Background="#A078C0E0"/>
            <Button x:Name="btnClearSelection" Content="Clear Selection" Click="ClearSelection_Click" Style="{StaticResource ActionButtonStyle}" Margin="5,0" Width="Auto" MinWidth="150" Padding="15,12" FontSize="15" Background="#A078C0E0"/>
            <Button x:Name="btnUpdateAll" Content="Update All" Click="UpdateAll_Click" Style="{StaticResource ActionButtonStyle}" Margin="5,0" Width="Auto" MinWidth="150" Padding="15,12" FontSize="15" Background="#A078C0E0"/>
        </StackPanel>

        <!-- Main Categories List -->
        <ListBox x:Name="CategoriesList" Grid.Row="1" 
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 Background="Transparent"
                 BorderThickness="0"
                 Focusable="False"
                 Margin="0,0,30,0">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,25">
                        <!-- Category Header -->
                        <TextBlock Text="{Binding CategoryName}" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,10" Foreground="#333"/>

                        <!-- Apps List (Horizontal Group) -->
                        <ListBox ItemsSource="{Binding Apps}" 
                                 Style="{StaticResource HorizontalAppListStyle}"
                                 PreviewMouseWheel="InnerScrollViewer_PreviewMouseWheel">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- App Card -->
                                    <Border Width="260" Height="140" Background="#F0F8FF" CornerRadius="10" Margin="5,0,10,10" Padding="15" MouseDown="AppItem_MouseDown">
                                        <Border.ToolTip>
                                            <ToolTip Background="White" BorderBrush="Black" BorderThickness="1" Foreground="Black" Padding="10">
                                                <StackPanel MaxWidth="300">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,0,5"/>
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </ToolTip>
                                        </Border.ToolTip>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                                <ColumnDefinition Width="*"/>    <!-- Info -->
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Icon -->
                                            <Image Grid.Column="0" Source="{Binding IconPath}" Width="45" Height="45" VerticalAlignment="Top" Margin="0,10,15,0" RenderOptions.BitmapScalingMode="HighQuality"/>

                                            <!-- Info -->
                                            <Grid Grid.Column="1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                
                                                <TextBlock Grid.Row="0" Text="{Binding Name}" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="12" Foreground="#555" TextWrapping="Wrap"  TextTrimming="CharacterEllipsis" Margin="0,2,0,0" MaxHeight="40"/>
                                                
                                                <Border Grid.Row="2" Background="#4CAF50" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                        Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                                </Border>

                                                <!-- Checkbox -->
                                                <CheckBox Grid.Row="2" IsChecked="{Binding IsSelected}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource RoundedCheckBoxStyle}"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
