<UserControl x:Class="HyperLisUI.Views.USBBootView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HyperLisUI.Views"
             xmlns:components="clr-namespace:HyperLisUI.Views.Components"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="900">

    <Grid Margin="-10,0,0,0">
        <Grid.Resources>
            <!-- Style for Horizontal Action Buttons -->
            <Style x:Key="HorizontalActionBtnStyle" TargetType="Button">
                <Setter Property="Background" Value="#60FFFFFF"/>
                <Setter Property="Foreground" Value="#334155"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#40FFFFFF"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Margin" Value="4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BgBorder" Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="15,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Grid.Column="0" Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    
                                    <ContentPresenter Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <ContentPresenter.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="13"/>
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="TextAlignment" Value="Left"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#475569"/>
                                            </Style>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BgBorder" Property="Background" Value="#B0FFFFFF"/>
                                    <Setter TargetName="BgBorder" Property="BorderBrush" Value="#80FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BgBorder" Property="Background" Value="#40FFFFFF"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="30,30,20,20">
            <StackPanel Margin="0,0,20,0">
                
                <!-- TOP SECTION -->
                
                <Border Background="#40FFFFFF" CornerRadius="12" Padding="25" Margin="0,0,0,25">
                    <StackPanel>
                        <!-- 1. Select USB -->
                        <TextBlock x:Name="lblUsbSelectDrive" Text="1. Chọn USB/Drive" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#1E293B"/>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbUSBDevices" SelectedIndex="0" Style="{StaticResource WinUIComboBoxStyle}" HorizontalAlignment="Stretch" Margin="0,0,15,0">
                                <ComboBoxItem Content="Loading drives..."/>
                            </ComboBox>
                            
                            <Button x:Name="BtnRescanDrives" Grid.Column="1" Click="BtnRescanDrives_Click" Background="White" Foreground="Black" BorderThickness="0" HorizontalAlignment="Stretch" Height="40" Padding="0" Margin="0">
                                <Button.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE72C;" Margin="0,0,8,0" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblUsbRescanBtn" Text="Scan USB/Drive Again" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 2. Select ISO -->
                        <TextBlock x:Name="lblUsbSelectWinVer" Text="2. Chọn File ISO (Mới)" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#1E293B"/>
                        
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbWindowsVersion" SelectedIndex="0" Style="{StaticResource WinUIComboBoxStyle}" HorizontalAlignment="Stretch" Margin="0,0,15,0" SelectionChanged="CmbWindowsVersion_SelectionChanged">
                                <ComboBoxItem Content="Loading versions..."/>
                            </ComboBox>
                            <TextBlock x:Name="lblUsbIsoDescription" Grid.Column="1" TextWrapping="Wrap" Foreground="#64748B" FontSize="13" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock x:Name="lblUsbSelectIso" Text="Hoặc chọn File ISO Cục Bộ" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#334155"/>
                        <Grid Margin="0,0,0,30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,10,0">
                                <TextBox x:Name="SelectISOTextBox" Text="Select directory to your iso" Background="Transparent" Padding="12" BorderThickness="0" VerticalContentAlignment="Center" FontSize="14" Foreground="#64748B"/>
                            </Border>
                            <Button x:Name="SelectISOBrowseBtn" Grid.Column="1" Content="Browse" VerticalAlignment="Stretch" Margin="0" Background="White" Foreground="Black" Padding="25,0" BorderThickness="0" Click="SelectISOBrowseBtn_Click">
                                <Button.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <!-- START BUTTON -->
                        <Button x:Name="BtnStart" Content="BẮT ĐẦU TẠO USB BOOT" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Stretch" Padding="15" FontSize="18" Margin="0,0,0,5" Click="Start_Click"/>

                    </StackPanel>
                </Border>

                <!-- BOTTOM SECTION -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/> 
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1.5*"/> 
                    </Grid.ColumnDefinitions>

                    <!-- HEADERS -->
                    <TextBlock x:Name="lblUsbGetOtherIso" Grid.Row="0" Grid.Column="0" Text="GET OTHER ISO" FontSize="16" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,10"/>
                    <TextBlock x:Name="lblUsbAuxFunctions" Grid.Row="0" Grid.Column="2" Text="AUXILIARY FUNCTIONS" FontSize="16" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,10"/>

                    <!-- LEFT: GET OTHER ISO -->
                    <Border Grid.Row="1" Grid.Column="0" Background="#40FFFFFF" CornerRadius="12" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <Grid Grid.Row="0" Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="pack://application:,,,/Images/windows.png" Width="32" Height="32" VerticalAlignment="Top" Margin="0,0,15,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="lblUsbChooseResource" Text="Choose a Resource" FontWeight="Bold" FontSize="15" Foreground="#1E293B"/>
                                    <TextBlock x:Name="lblUsbSelectSource" Text="Select another source to download the Windows ISO." FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <ComboBox x:Name="CmbResources" Grid.Row="1" SelectedIndex="0" Style="{StaticResource WinUIComboBoxStyle}" Margin="0,0,0,20" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Loading..."/>
                            </ComboBox>
                            
                            <Button x:Name="BtnOpenResource" Grid.Row="2" Click="BtnOpenResource_Click" Content="Let's go" Style="{StaticResource ActionButtonStyle}" Width="120" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#A078C0E0"/>
                        </Grid>
                    </Border>

                    <!-- RIGHT: CHỨC NĂNG BỔ TRỢ -->
                    <Border Grid.Row="1" Grid.Column="2" Background="#40FFFFFF" CornerRadius="12" Padding="15">
                        <Grid VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Row 0 -->
                            <Button x:Name="BtnDownloadOnly" Grid.Row="0" Grid.Column="0" Click="DownloadOnly_Click" Style="{StaticResource HorizontalActionBtnStyle}" Tag="&#xE753;"/>
                            <Button x:Name="BtnCreateBootloader" Grid.Row="0" Grid.Column="1" Click="CreateBootloaderOnly_Click" Style="{StaticResource HorizontalActionBtnStyle}" Tag="&#xEDE3;"/>
                            
                            <!-- Row 1 -->
                            <Button x:Name="BtnAddIsoToUsb" Grid.Row="1" Grid.Column="0" Click="AddIsoToUsb_Click" Style="{StaticResource HorizontalActionBtnStyle}" Tag="&#xE78B;"/>
                            <Button x:Name="BtnRestartBios" Grid.Row="1" Grid.Column="1" Click="RestartBios_Click" Style="{StaticResource HorizontalActionBtnStyle}" Tag="&#xE7E8;"/>
                            
                            <!-- Row 2 (Spanned) -->
                            <Button x:Name="BtnFixWmic" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Click="FixWmic_Click" Style="{StaticResource HorizontalActionBtnStyle}" Tag="&#xE90F;"/>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
