<UserControl x:Class="HyperLisUI.Views.ConvertSKUView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HyperLisUI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="1200" d:DesignWidth="1100" Background="Transparent"
             RenderOptions.BitmapScalingMode="HighQuality"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <PathGeometry x:Key="CheckmarkIcon">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z</PathGeometry>

        <!-- OS Selection RadioButton Style -->
        <Style x:Key="SKUCardRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#fdfcfd"/>
            <Setter Property="BorderBrush" Value="#E5E5E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Padding" Value="15,15"/>
            <Setter Property="Margin" Value="0,0,15,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <Grid>
                                <ContentPresenter Margin="{TemplateBinding Padding}" 
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                <Path x:Name="CheckIcon" 
                                      Data="{StaticResource CheckmarkIcon}" 
                                      Fill="#0078D4" Width="18" Height="18" Stretch="Uniform" 
                                      HorizontalAlignment="Right" VerticalAlignment="Top" 
                                      Margin="0,10,10,0" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F9F9F9"/>
                                <Setter Property="BorderBrush" Value="#D0D0D0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#F0F6FF"/>
                                <Setter Property="BorderBrush" Value="#0078D4"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Edition Selection RadioButton Style -->
        <Style x:Key="EditionRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E5E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <Grid>
                                <ContentPresenter Margin="{TemplateBinding Padding}" 
                                                  HorizontalAlignment="Left" 
                                                  VerticalAlignment="Center"/>
                                <Image x:Name="RadioIcon" Source="/Images/unselect.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F9F9F9"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#F0F6FF"/>
                                <Setter Property="BorderBrush" Value="#0078D4"/>
                                <Setter TargetName="RadioIcon" Property="Source" Value="/Images/selected.png"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#004578"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#0078D4"/>
            <Setter Property="BorderBrush" Value="#0078D4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0F6FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E5F0FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="20,20,20,15">
            <Grid.ColumnDefinitions>
            <!-- Left Column (Settings) -->
            <ColumnDefinition Width="6*" />
            <!-- Spacing -->
            <ColumnDefinition Width="0.3*" />
            <!-- Right Column (Preview & Action) -->
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,5,0" MinHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title & Subtitle -->
                    <RowDefinition Height="Auto"/> <!-- Section 1 -->
                    <RowDefinition Height="Auto"/> <!-- Section 2 -->
                    <RowDefinition Height="*"/>    <!-- Section 3 -->
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock x:Name="lblConvertSKU_Title" Text="Convert SKUs - Change Windows Edition" FontSize="26" FontWeight="Bold" Foreground="#1E1E1E" Margin="0,0,0,5"/>
                    <TextBlock x:Name="lblConvertSKU_SubTitle" Text="Changing the current Edition of Windows to another Edition quickly and safely." FontSize="13" Foreground="#6C6C6C" Margin="0,0,0,25"/>
                </StackPanel>

                <!-- Section 1: Current Windows Info -->
                <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,25">
                    <StackPanel>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="lblSection1Title" Text="1. Current Windows Info" FontSize="15" FontWeight="SemiBold" Foreground="#005A9E" VerticalAlignment="Center"/>
                            <!-- Shield Icon inside rounded button -->
                            <Border Grid.Column="1" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="6" Background="White" Padding="8">
                                <TextBlock Text="&#xEAC9;" FontFamily="pack://application:,,,/Resources/Fonts/#Fluent System Icons, pack://application:,,,/Resources/Fonts/#FluentSystemIcons-Regular" FontSize="18" Foreground="#0078D4" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Top part: Logo & OS Name -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" Background="#F4F8FE" CornerRadius="8" Width="72" Height="72" Margin="0,0,20,0">
                                <Image x:Name="imgOsLogo" Source="/Images/windows11.png" Width="42" Height="42" VerticalAlignment="Center" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="txtOsName" Text="Windows 11 Pro" FontSize="20" FontWeight="Bold" Foreground="#1E1E1E" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#F4FCF7" BorderBrush="#D4EDDC" BorderThickness="1" CornerRadius="6" Padding="12,4" Margin="0,0,10,0">
                                        <TextBlock x:Name="txtActivationTag" Text="Activated" FontSize="12" FontWeight="SemiBold" Foreground="#1A7C36"/>
                                    </Border>
                                    <Border Background="#F2F6FE" BorderBrush="#DCE6F9" BorderThickness="1" CornerRadius="6" Padding="12,4">
                                        <TextBlock x:Name="txtChannelTag" Text="Retail" FontSize="12" FontWeight="SemiBold" Foreground="#2A68CC"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        
                        <Separator Grid.Row="1" Background="#EFEFEF" Margin="0,10"/>
                        
                        <!-- Details Grid -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Col 1 -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="&#xF4A2;" FontFamily="pack://application:,,,/Resources/Fonts/#Fluent System Icons, pack://application:,,,/Resources/Fonts/#FluentSystemIcons-Regular" Width="20" Foreground="#888" Margin="0,2,0,0"/>
                                <TextBlock x:Name="lblVersion" Text="Version" Width="105" Foreground="#666"/>
                                <TextBlock x:Name="txtVersion" Text="24H2" FontWeight="Medium" Foreground="#333"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="&#xE216;" FontFamily="pack://application:,,,/Resources/Fonts/#Fluent System Icons, pack://application:,,,/Resources/Fonts/#FluentSystemIcons-Regular" Width="20" Foreground="#888" Margin="0,2,0,0"/>
                                <TextBlock x:Name="lblBuild" Text="Build" Width="105" Foreground="#666"/>
                                <TextBlock x:Name="txtBuild" Text="26100.2605" FontWeight="Medium" Foreground="#333"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="&#xE498;" FontFamily="pack://application:,,,/Resources/Fonts/#Fluent System Icons, pack://application:,,,/Resources/Fonts/#FluentSystemIcons-Regular" Width="20" Foreground="#888" Margin="0,2,0,0"/>
                                <TextBlock x:Name="lblArchitecture" Text="Architecture" Width="105" Foreground="#666"/>
                                <TextBlock x:Name="txtArchitecture" Text="64-bit (x64)" FontWeight="Medium" Foreground="#333"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="&#xE740;" FontFamily="pack://application:,,,/Resources/Fonts/#Fluent System Icons, pack://application:,,,/Resources/Fonts/#FluentSystemIcons-Regular" Width="20" Foreground="#888" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblProductID" Text="Product ID" Width="105" Foreground="#666" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtProductId" Text="00330-80000-00000-AA676" FontWeight="Medium" Foreground="#333" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <!-- Col 2 -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="&#xE24D;" FontFamily="pack://application:,,,/Resources/Fonts/#Fluent System Icons, pack://application:,,,/Resources/Fonts/#FluentSystemIcons-Regular" Width="20" Foreground="#888" Margin="0,2,0,0"/>
                                <TextBlock x:Name="lblInstallDate" Text="Install date" Width="105" Foreground="#666"/>
                                <TextBlock x:Name="txtInstallDate" Text="12/09/2024" FontWeight="Medium" Foreground="#333"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="&#xF2DC;" FontFamily="pack://application:,,,/Resources/Fonts/#Fluent System Icons, pack://application:,,,/Resources/Fonts/#FluentSystemIcons-Regular" Width="20" Foreground="#888" Margin="0,2,0,0"/>
                                <TextBlock x:Name="lblLastBoot" Text="Last boot" Width="105" Foreground="#666"/>
                                <TextBlock x:Name="txtLastBoot" Text="20/05/2025 09:12" FontWeight="Medium" Foreground="#333"/>
                            </StackPanel>
                            
                            <Grid Grid.Row="4" Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="105"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xF297;" FontFamily="pack://application:,,,/Resources/Fonts/#Fluent System Icons, pack://application:,,,/Resources/Fonts/#FluentSystemIcons-Regular" Width="20" Foreground="#1A7C36" Margin="0,2,0,0" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" x:Name="lblLicenseStatus" Text="License status" Width="105" Foreground="#666" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="2" x:Name="txtLicenseStatus" Text="Loading..." FontWeight="Medium" Foreground="#1A7C36" TextWrapping="Wrap" VerticalAlignment="Top"/>
                            </Grid>
                        </Grid>
                        
                        <Grid Grid.Row="4" x:Name="panelKeysInfo" Margin="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="105"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xF4A2;" FontFamily="pack://application:,,,/Resources/Fonts/#Fluent System Icons, pack://application:,,,/Resources/Fonts/#FluentSystemIcons-Regular" Width="20" Foreground="#888" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="lblConvertSKU_OEMEdition" Text="OEM Edition:" Width="105" Foreground="#666" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" x:Name="txtOemEdition" Text="Loading..." FontWeight="Medium" Foreground="#333" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                        </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section 2: Choose Windows Version -->
                <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock x:Name="lblSection2Title" Text="2. Choose Windows Version" FontSize="15" FontWeight="SemiBold" Foreground="#005A9E" Margin="0,0,0,15"/>
                        <UniformGrid Columns="2" Margin="0,0,0,5">
                            <!-- Windows 10 -->
                            <RadioButton x:Name="rbWin10" GroupName="OSVersion" Style="{StaticResource SKUCardRadioButtonStyle}" Checked="rbOSVersion_Checked" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="/Images/windows10.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0" VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Windows 10" FontWeight="Bold" FontSize="15" Margin="0,0,0,4"/>
                                        <TextBlock Text="Home, Pro, Enterprise,..." FontSize="11" Foreground="#666" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </RadioButton>

                            <!-- Windows 10 LTS -->
                            <RadioButton x:Name="rbWin10LTS" GroupName="OSVersion" Style="{StaticResource SKUCardRadioButtonStyle}" Checked="rbOSVersion_Checked" Visibility="Collapsed" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="/Images/windows10.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0" VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Windows 10 LTS" FontWeight="Bold" FontSize="15" Margin="0,0,0,4"/>
                                        <TextBlock Text="LTSB, LTSC" FontSize="11" Foreground="#666" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </RadioButton>

                            <!-- Windows 11 -->
                            <RadioButton x:Name="rbWin11" GroupName="OSVersion" Style="{StaticResource SKUCardRadioButtonStyle}" Checked="rbOSVersion_Checked" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="/Images/windows11.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0" VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Windows 11" FontWeight="Bold" FontSize="15" Margin="0,0,0,4"/>
                                        <TextBlock Text="Home, Pro, Enterprise,..." FontSize="11" Foreground="#666" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </RadioButton>

                            <!-- Windows 11 LTSC -->
                            <RadioButton x:Name="rbWin11LTSC" GroupName="OSVersion" Style="{StaticResource SKUCardRadioButtonStyle}" Checked="rbOSVersion_Checked" Visibility="Collapsed" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="/Images/windows11.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0" VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Windows 11 LTSC" FontWeight="Bold" FontSize="15" Margin="0,0,0,4"/>
                                        <TextBlock Text="Enterprise LTSC" FontSize="11" Foreground="#666" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </RadioButton>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Section 3: Choose Target Edition -->
                <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20" VerticalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock x:Name="lblSection3Title" Text="3. Choose Target Edition" FontSize="15" FontWeight="SemiBold" Foreground="#005A9E" Margin="0,0,0,15"/>
                        <StackPanel x:Name="panelRegularEditions" Margin="0,0,0,5">
                            <!-- HOME CATEGORY -->
                            <TextBlock Text="Home" FontSize="12" FontWeight="SemiBold" Foreground="#777" Margin="0,0,0,8"/>
                            <UniformGrid Columns="3" Margin="0,0,0,10">
                                <RadioButton GroupName="Edition" Style="{StaticResource EditionRadioButtonStyle}" Checked="Edition_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xF481;" FontFamily="pack://application:,,,/Resources/Fonts/#Fluent System Icons, pack://application:,,,/Resources/Fonts/#FluentSystemIcons-Regular" FontSize="16" Foreground="#555" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Home" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="Edition" Style="{StaticResource EditionRadioButtonStyle}" Checked="Edition_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xF481;" FontFamily="pack://application:,,,/Resources/Fonts/#Fluent System Icons, pack://application:,,,/Resources/Fonts/#FluentSystemIcons-Regular" FontSize="16" Foreground="#555" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Home Single Language" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>

                            <!-- PRO CATEGORY -->
                            <TextBlock Text="Pro" FontSize="12" FontWeight="SemiBold" Foreground="#777" Margin="0,0,0,8"/>
                            <UniformGrid Columns="3" Margin="0,0,0,10">
                                <RadioButton GroupName="Edition" IsChecked="True" Style="{StaticResource EditionRadioButtonStyle}" Checked="Edition_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xF710;" FontFamily="pack://application:,,,/Resources/Fonts/#Fluent System Icons, pack://application:,,,/Resources/Fonts/#FluentSystemIcons-Regular" FontSize="16" Foreground="#555" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Pro" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="Edition" Style="{StaticResource EditionRadioButtonStyle}" Checked="Edition_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xF35A;" FontFamily="pack://application:,,,/Resources/Fonts/#Fluent System Icons, pack://application:,,,/Resources/Fonts/#FluentSystemIcons-Regular" FontSize="16" Foreground="#555" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Pro for Workstations" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="Edition" Style="{StaticResource EditionRadioButtonStyle}" Checked="Edition_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE6E7;" FontFamily="pack://application:,,,/Resources/Fonts/#Fluent System Icons, pack://application:,,,/Resources/Fonts/#FluentSystemIcons-Regular" FontSize="16" Foreground="#555" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Pro Education" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="Edition" Style="{StaticResource EditionRadioButtonStyle}" Checked="Edition_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xF710;" FontFamily="pack://application:,,,/Resources/Fonts/#Fluent System Icons, pack://application:,,,/Resources/Fonts/#FluentSystemIcons-Regular" FontSize="16" Foreground="#555" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Pro Single Language" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>

                            <!-- EDUCATION CATEGORY -->
                            <TextBlock Text="Education" FontSize="12" FontWeight="SemiBold" Foreground="#777" Margin="0,0,0,8"/>
                            <UniformGrid Columns="3" Margin="0,0,0,10">
                                <RadioButton GroupName="Edition" Style="{StaticResource EditionRadioButtonStyle}" Checked="Edition_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE6E7;" FontFamily="pack://application:,,,/Resources/Fonts/#Fluent System Icons, pack://application:,,,/Resources/Fonts/#FluentSystemIcons-Regular" FontSize="16" Foreground="#555" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Education" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                
                            </UniformGrid>

                            <!-- ENTERPRISE CATEGORY -->
                            <TextBlock Text="Enterprise" FontSize="12" FontWeight="SemiBold" Foreground="#777" Margin="0,0,0,8"/>
                            <UniformGrid Columns="3" Margin="0,0,0,0">
                                <RadioButton GroupName="Edition" Style="{StaticResource EditionRadioButtonStyle}" Checked="Edition_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xF205;" FontFamily="pack://application:,,,/Resources/Fonts/#Fluent System Icons, pack://application:,,,/Resources/Fonts/#FluentSystemIcons-Regular" FontSize="16" Foreground="#555" Margin="0,0,10,0" VerticalAlignment="Center"/>
