<UserControl x:Class="HyperLisUI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HyperLisUI.Views"
             xmlns:components="clr-namespace:HyperLisUI.Views.Components"
             mc:Ignorable="d" 
             d:DesignHeight="880" d:DesignWidth="1250"
             Background="Transparent"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.ClearTypeHint="Enabled"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- ACCENT COLORS -->
        <SolidColorBrush x:Key="CpuBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="RamBrush" Color="#00A3FF"/>
        <SolidColorBrush x:Key="GpuBrush" Color="#818CF8"/>

        <!-- LUMINOUS CRISP WHITE CARD STYLE (No Effect = 100% Crisp ClearType Subpixel Rendering) -->
        <Style x:Key="GlassCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
        </Style>

        <!-- TOP LINK CARD STYLE (Facebook, GitHub, Website) -->
        <Style x:Key="TopLinkCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                    <Setter Property="BorderBrush" Value="#0078D4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DASHBOARD TOGGLE SWITCH (Reusing exact App.xaml ToggleSwitchStyle: #00B2FF, White thumb with shadow, Storyboard) -->
        <Style x:Key="DashboardToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <!-- Toggle Track -->
                            <Border x:Name="Border" Width="40" Height="22" CornerRadius="11" Background="#DDDDDD" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse x:Name="Ellipse" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect ShadowDepth="1" BlurRadius="2" Opacity="0.3"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Border>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Border" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#00B2FF" Duration="0:0:0.1"/>
                                            <ThicknessAnimation Storyboard.TargetName="Ellipse" Storyboard.TargetProperty="Margin" To="20,0,0,0" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Border" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#DDDDDD" Duration="0:0:0.1"/>
                                            <ThicknessAnimation Storyboard.TargetName="Ellipse" Storyboard.TargetProperty="Margin" To="2,0,0,0" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PILL BUTTON FOR CARD HEADERS -->
        <!-- PILL/FLAT BUTTON FOR CARD HEADERS -->
        <Style x:Key="PillHeaderBtnStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontSize="11.5" TextElement.FontWeight="SemiBold" TextElement.Foreground="#0078D4"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#0078D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PRIMARY BLUE PILL BUTTON (e.g. Apply All >) -->
        <Style x:Key="PrimaryBlueBtnStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontSize="11.5" TextElement.FontWeight="Bold" TextElement.Foreground="White"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#106EBE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MINI ACTION BUTTON (e.g. Clean, Check) -->
        <Style x:Key="SmallActionBtnStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontSize="12" TextElement.FontWeight="SemiBold" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- HORIZONTAL PROGRESS BAR STYLE FOR STORAGE DRIVES -->
        <Style x:Key="StorageProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#00A3FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="3" Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3" Background="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MINI GPU COMBOBOX STYLES -->
        <ControlTemplate x:Key="GpuComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="Border" CornerRadius="6" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="1" Data="M0,0 L3.5,3.5 L7,0" Stroke="#64748B" StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,4,0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#F8FAFC"/>
                    <Setter TargetName="Border" Property="BorderBrush" Value="#0078D4"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#0078D4"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="GpuComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                                <Setter Property="Foreground" Value="#0078D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GpuComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="23"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource GpuComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" 
                                          Template="{StaticResource GpuComboBoxToggleButtonTemplate}" 
                                          Background="{TemplateBinding Background}" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          FocusVisualStyle="{x:Null}"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False"  
                                              Margin="8,0,18,0" VerticalAlignment="Center" HorizontalAlignment="Center" 
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                            
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#FFFFFF" BorderThickness="1" BorderBrush="#E2E8F0" CornerRadius="6" Margin="0,3,0,4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.1" Color="#0F172A"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#0078D4"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter Property="BorderBrush" Value="#0078D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"
                  ScrollChanged="MainScrollViewer_ScrollChanged">
        <Grid Margin="24,12,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: 3 Link Cards -->
                <RowDefinition Height="12"/>   <!-- Spacer -->
                <RowDefinition Height="*"/>    <!-- Row 2: 2-Column Dashboard Grid -->
            </Grid.RowDefinitions>

            <!-- ROW 0: 3 TOP LINK CARDS (FB, GITHUB, WEBSITE) -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- CARD 1: FACEBOOK -->
                <Border Grid.Column="0" Style="{StaticResource TopLinkCardStyle}" MouseLeftButtonUp="FacebookCard_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="#EFF6FF" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Image Source="pack://application:,,,/Images/fb.png" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="lblFacebookTitle" Text="Facebook" FontSize="14.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock x:Name="lblFacebookDesc" Text="Cộng đồng Zịt's Tech Lab" FontSize="12" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE76C;" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </Grid>
                </Border>

                <!-- CARD 2: GITHUB -->
                <Border Grid.Column="2" Style="{StaticResource TopLinkCardStyle}" MouseLeftButtonUp="GithubCard_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="#F1F5F9" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Path Data="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                                  Fill="#1E293B" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="lblGithubTitle" Text="GitHub Repository" FontSize="14.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock x:Name="lblGithubDesc" Text="Mã nguồn &amp; đóng góp dự án" FontSize="12" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE76C;" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </Grid>
                </Border>

                <!-- CARD 3: WEBSITE -->
                <Border Grid.Column="4" Style="{StaticResource TopLinkCardStyle}" MouseLeftButtonUp="WebsiteCard_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="#ECFDF5" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE774;" FontSize="20" Foreground="#059669" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="lblWebsiteTitle" Text="Website" FontSize="14.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock x:Name="lblWebsiteDesc" Text="Trang chủ chính thức HyperLis" FontSize="12" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE76C;" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ROW 2: 2-COLUMN DASHBOARD GRID -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*"/> <!-- Left Column (~61%) -->
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1*"/>    <!-- Right Column (~39%) -->
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: SYSTEM PERFORMANCE + STORAGE & DRIVES -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Row 0: System Performance -->
                        <RowDefinition Height="12"/>   <!-- Row 1: Spacer -->
                        <RowDefinition Height="*"/>    <!-- Row 2: Storage & Drives (stretches to align with Changelog) -->
                    </Grid.RowDefinitions>

                    <!-- CARD 1: SYSTEM PERFORMANCE -->
                    <Border Grid.Row="0" Style="{StaticResource GlassCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header Row -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE9D9;" FontSize="16" Foreground="#0078D4" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="lblPerfTracker" Text="System Performance" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>

                                    <!-- Scanning Indicator -->
                                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding IsLoadingHardware, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Scanning" FontSize="12" Foreground="#4B5563" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding LoadingDots}" FontSize="12" Foreground="#4B5563" VerticalAlignment="Center" Width="16"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Right: Real-time Badge + Arrow -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="12" Padding="8,3" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Real-time" FontSize="11" FontWeight="SemiBold" Foreground="#15803D"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE76C;" FontSize="12" Foreground="#4B5563" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- 3 Circular Gauges with Specs & Wave Sparklines -->
                            <Grid Grid.Row="1" Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- CPU GAUGE COLUMN -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <Image Source="pack://application:,,,/Images/CPU.png" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock x:Name="lblCPU" Text="CPU" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <components:CircularProgressBar x:Name="CpuProgress" Width="106" Height="106" ProgressColor="{StaticResource CpuBrush}" Value="0" Text="0%" Subtext="Unknown GHz"/>
                                    <TextBlock x:Name="CpuNameText" Text="Loading CPU..." FontSize="12.5" FontWeight="SemiBold" Foreground="#1F2937" HorizontalAlignment="Center" Margin="0,8,0,2" TextTrimming="CharacterEllipsis" MaxWidth="210"/>
                                </StackPanel>

                                <!-- RAM GAUGE COLUMN -->
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <Image Source="pack://application:,,,/Images/RAM.png" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock x:Name="lblRAM" Text="RAM" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <components:CircularProgressBar x:Name="RamProgress" Width="106" Height="106" ProgressColor="{StaticResource RamBrush}" Value="0" Text="0%" Subtext="0/0 GB"/>
                                    <TextBlock x:Name="RamDetailsText" Text="Loading RAM..." FontSize="12.5" FontWeight="SemiBold" Foreground="#1F2937" HorizontalAlignment="Center" Margin="0,8,0,2" TextTrimming="CharacterEllipsis" MaxWidth="210"/>
                                </StackPanel>

                                <!-- GPU GAUGE COLUMN -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <Image Source="pack://application:,,,/Images/VGA.png" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock x:Name="lblGPU" Text="GPU" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="GpuSelector" Style="{StaticResource GpuComboBoxStyle}" Width="78" Height="24" FontSize="11.5" Margin="6,0,0,0" SelectionChanged="GpuSelector_SelectionChanged" Visibility="Visible"/>
                                    </StackPanel>
                                    <components:CircularProgressBar x:Name="GpuProgress" Width="106" Height="106" ProgressColor="{StaticResource GpuBrush}" Value="0" Text="0%" Subtext="0% VRAM"/>
                                    <TextBlock x:Name="GpuNameText" Text="Loading GPU..." FontSize="12.5" FontWeight="SemiBold" Foreground="#1F2937" HorizontalAlignment="Center" Margin="0,8,0,2" TextTrimming="CharacterEllipsis" MaxWidth="210"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- CARD 2: STORAGE & DRIVES -->
                    <Border Grid.Row="2" x:Name="StorageCard" Style="{StaticResource GlassCardStyle}" VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xEDA2;" FontSize="15" Foreground="#0078D4" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="lblStorageDrives" Text="Storage &amp; Drives" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Right Button: Optimize > -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="btnMoreDrives" Style="{StaticResource PillHeaderBtnStyle}" Click="MoreDrives_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="lblMore" Text="Optimize" FontSize="11.5" FontWeight="SemiBold" Foreground="#0078D4" VerticalAlignment="Center"/>
                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE76C;" FontSize="11" Foreground="#0078D4" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Dynamic Drives List (1 drive per row, full width) -->
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding DrivesList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="13,9" Margin="0,0,0,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                   <ColumnDefinition Width="Auto"/>
                                                   <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Drive Icon -->
                                                <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <Image Source="/Images/windows11.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"
                                                           Visibility="{Binding IsSystemDrive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <Border Width="28" Height="28" CornerRadius="6" Background="#F1F5F9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Visibility="{Binding IsNonSystemDrive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xEDA2;" FontSize="17" Foreground="#1F2937" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>

                                                <!-- Drive Usage & Progress Bar -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <!-- Title & Percent -->
                                                    <Grid Margin="0,0,0,3">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding PercentText}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <!-- Progress Bar -->
                                                    <ProgressBar Style="{StaticResource StorageProgressBarStyle}" Value="{Binding PercentValue}" Maximum="100" Margin="0,0,0,3"/>
                                                    <!-- Capacity & File System / Type -->
                                                    <Grid>
                                                        <TextBlock Text="{Binding FormatAndType}" FontSize="11.5" FontWeight="Normal" Foreground="#64748B" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding UsageText}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>

                <!-- RIGHT COLUMN: CHANGELOG -->
                <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header (Fixed icon: &#xE7C3; for Windows 10 & 11) -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE7C3;" FontSize="15" Foreground="#0078D4" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ChangelogHeaderTitle" Text="Changelog" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- View All Button -->
                            <Button x:Name="BtnViewAllChangelog" Content="View All" Style="{StaticResource PillHeaderBtnStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnViewAllChangelog_Click"/>
                        </Grid>

                        <!-- Timeline Entries -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="ChangelogScrollViewer_PreviewMouseWheel">
                            <ItemsControl x:Name="ChangelogList" ItemsSource="{Binding ChangelogItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,14">
                                            <!-- Version Header with Dot + Title + Date -->
                                            <Grid Margin="0,0,0,5">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="8.5" Height="8.5" Fill="{Binding DotBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding version_value}" FontWeight="SemiBold" FontSize="14.5" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding date}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12.5" FontWeight="Normal" Foreground="#64748B"/>
                                            </Grid>

                                            <!-- Bullet Points -->
                                            <ItemsControl ItemsSource="{Binding content}" Margin="15,2,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="•" FontSize="15" Foreground="#0078D4" Margin="0,0,7,0" VerticalAlignment="Top"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontSize="13" Foreground="#334155" LineHeight="19"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
