<UserControl x:Class="HyperLisUI.Views.NetworkDescriptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="300">
             
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Description:" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,15"/>
            <TextBlock Text="In this section, you can choose the most suitable DNS server for your PC to ensure the best connection. We also provide multiple options to help you achieve lower ping and a smoother gaming experience." 
                       TextWrapping="Wrap" FontSize="17" LineHeight="22" Margin="0,0,0,25" Foreground="Black"/>
            
            <Separator Background="#80FFFFFF" Margin="0,0,0,20"/>
            
            <TextBlock Text="Mô tả:" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,15"/>
            <TextBlock Text="Trong phần này, bạn có thể chọn máy chủ DNS phù hợp nhất cho PC của mình để đảm bảo kết nối tốt nhất. Chúng tôi cũng cung cấp nhiều tùy chọn để giúp bạn đạt được ping thấp hơn và trải nghiệm chơi game mượt mà hơn." 
                       TextWrapping="Wrap" FontSize="17" LineHeight="22" Margin="0,0,0,25" Foreground="Black"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
