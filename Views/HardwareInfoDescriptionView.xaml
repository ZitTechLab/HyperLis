<UserControl x:Class="HyperLisUI.Views.HardwareInfoDescriptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HyperLisUI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="300">
    <StackPanel>
        <TextBlock Text="Description:" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,15"/>
        <TextBlock Text="Get a clear snapshot of your entire hardware in one place." 
                   TextWrapping="Wrap" FontSize="17" LineHeight="22" Margin="0,0,0,25" Foreground="Black"/>

        <Separator Background="#80FFFFFF" Margin="0,0,0,20"/>

        <TextBlock Text="Mô tả:" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,15"/>
        <TextBlock Text="Tính năng này giúp tổng hợp thông tin phần cứng của máy bạn và hiển thị trực quan hơn" 
                   TextWrapping="Wrap" FontSize="17" LineHeight="22" Margin="0,0,0,25" Foreground="Black"/>
    </StackPanel>
</UserControl>
