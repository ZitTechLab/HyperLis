<Window x:Class="HyperLisUI.Views.Components.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Available" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Style for Bottom Buttons -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Shadow Effect -->
        <Border Margin="20" Background="White" CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.15" Color="#000" />
            </Border.Effect>
        </Border>

        <!-- Main Content -->
        <Border Margin="20" Background="White" CornerRadius="16" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="*"/>    <!-- Changelog box -->
                    <RowDefinition Height="Auto"/> <!-- Footer -->
                </Grid.RowDefinitions>

                <!-- Close Button -->
                <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="15" 
                        Width="30" Height="30" Background="Transparent" BorderThickness="0" 
                        Cursor="Hand" Click="CloseButton_Click">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0F0F0" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Header Section -->
                <Grid Grid.Row="0" Margin="30,30,30,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon / Image Placeholder -->
                    <Border Width="80" Height="80" CornerRadius="16" Margin="0,0,20,0" Grid.Column="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#E6EFFF" Offset="0" />
                                <GradientStop Color="#D0E3FF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Image Source="/Images/Update/icon1.png" Stretch="Uniform" Margin="5" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <!-- Title & Details -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="24" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#111">
                            <Run Text="HyperLis " /><Run x:Name="VersionRun" Text="1.0.5" Foreground="#1C69FF" /><Run x:Name="IsAvailableRun" Text=" is available!" />
                        </TextBlock>
                        
                        <TextBlock x:Name="UpdateReadyText" Text="A new update is ready to improve your experience." 
                                   FontSize="14" Foreground="#666" Margin="0,0,0,10" />

                        <StackPanel Orientation="Horizontal">
                            <!-- Date -->
                            <TextBlock Text="&#xE787;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="#888" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock x:Name="ReleaseDateText" Text="Released: 23/05/2026" FontSize="13" Foreground="#888" VerticalAlignment="Center" />
                            
                            <TextBlock Text=" • " FontSize="14" Foreground="#CCC" VerticalAlignment="Center" Margin="10,0" />
                            
                            <!-- Size -->
                            <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="#888" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock x:Name="SizeText" Text="Size: 12.4 MB" FontSize="13" Foreground="#888" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Changelog Box -->
                <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="12" Margin="30,0,30,20" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        
                        <!-- Box Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="WhatsNewText" Text="What's new in v" FontSize="16" FontWeight="SemiBold" Foreground="#1C69FF" />
                                <TextBlock x:Name="ChangelogVersionRun" Text="1.0.5" FontSize="16" FontWeight="SemiBold" Foreground="#1C69FF" Margin="0,0,10,0"/>
                                
                                <Border Background="#D9E8FF" CornerRadius="8" Padding="8,2">
                                    <TextBlock x:Name="NewBadgeText" Text="NEW" FontSize="10" FontWeight="Bold" Foreground="#1C69FF" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                            
                            <Button x:Name="ViewChangelogLink" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand" HorizontalAlignment="Right" Click="ViewChangelogLink_Click">
                                <StackPanel Orientation="Horizontal" Margin="12,6">
                                    <TextBlock x:Name="ViewChangelogText" Text="View full changelog" FontSize="13" Foreground="#1C69FF" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock Text="&#xE72A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" FontWeight="Bold" Foreground="#1C69FF" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F4F7FB" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <Separator Grid.Row="0" VerticalAlignment="Bottom" Margin="-20,0,-20,0" Background="#E2E8F0" Height="1" />

                        <!-- Changelog List -->
                        <ScrollViewer Grid.Row="1" Margin="0,15,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ChangelogPanel">
                                <!-- Items will be added dynamically via code-behind -->
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Footer (Buttons) -->
                <Grid Grid.Row="2" Margin="30,0,30,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="chkDontShowAgain" Content="Don't show again for this version" 
                              VerticalAlignment="Center">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox">
                                <Setter Property="Foreground" Value="#555" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="CheckBox">
                                            <StackPanel Orientation="Horizontal">
                                                <Border x:Name="Border" Width="18" Height="18" Background="White" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="4" Margin="0,0,8,0">
                                                    <Path x:Name="CheckMark" Data="M 0,4 L 3,7 L 9,0" Stretch="Uniform" Width="9" Height="7" Stroke="White" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/>
                                                </Border>
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#1C69FF" />
                                                    <Setter TargetName="Border" Property="BorderBrush" Value="#1C69FF" />
                                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="BorderBrush" Value="#1C69FF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" x:Name="ButtonPanel">
                        <!-- Skip Button -->
                        <Button Style="{StaticResource RoundedButtonStyle}" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" 
                                Padding="15,8" Margin="0,0,10,0" Click="SkipButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="#555" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock x:Name="SkipButtonText" Text="Skip" FontSize="14" FontWeight="Medium" Foreground="#444" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Remind Later Button -->
                        <Button Style="{StaticResource RoundedButtonStyle}" Background="#F0F5FF" BorderThickness="0" 
                                Padding="15,8" Margin="0,0,10,0" Click="LaterButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE121;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="#1C69FF" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock x:Name="RemindLaterButtonText" Text="Remind me later" FontSize="14" FontWeight="Medium" Foreground="#1C69FF" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Update Now Button -->
                        <Button Style="{StaticResource RoundedButtonStyle}" Background="#1C69FF" BorderThickness="0" 
                                Padding="20,8" Click="UpdateButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock x:Name="UpdateNowButtonText" Text="Update Now" FontSize="14" FontWeight="Medium" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    
                    <!-- Progress Section (replaces buttons when downloading) -->
                    <StackPanel x:Name="ProgressPanel" Grid.Column="1" Visibility="Collapsed" VerticalAlignment="Center" Width="280">
                        <TextBlock x:Name="ProgressText" Text="Downloading update... 0%" Foreground="#555" FontSize="13" Margin="0,0,0,5" HorizontalAlignment="Right"/>
                        <ProgressBar x:Name="DownloadProgress" Height="8" Minimum="0" Maximum="100" Value="0" 
                                     Foreground="#1C69FF" Background="#E2E8F0" BorderThickness="0">
                            <ProgressBar.Template>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Grid>
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4" />
                                        <Border x:Name="PART_Track" />
                                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="4" />
                                    </Grid>
                                </ControlTemplate>
                            </ProgressBar.Template>
                        </ProgressBar>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
