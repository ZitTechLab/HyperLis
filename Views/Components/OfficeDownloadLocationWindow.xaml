<Window x:Class="HyperLisUI.Views.Components.OfficeDownloadLocationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chon vi tri luu tai xuong"
        Width="543"
        Height="340"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <Viewbox Stretch="Fill">
    <Grid Width="410" Height="260">
        <Border Margin="8" Background="#FAFBFC" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.20" Color="#111827"/>
            </Border.Effect>
        </Border>

        <Border Margin="8" Background="#FAFBFC" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,10,14,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Images/Office/folder.png"
                               Width="11"
                               Height="11"
                               Margin="0,0,5,0"
                               VerticalAlignment="Center"/>
                        <TextBlock Text="Chọn vị trí lưu tải xuống"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#1F2937"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            x:Name="btnClose"
                            Content="✕"
                            Width="17"
                            Height="17"
                            FontSize="9"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#4B5563"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Click="Close_Click"/>
                </Grid>

                <TextBlock Grid.Row="1"
                           Margin="0,9,0,8"
                           Text="Chọn thư mục để tải xuống bộ cài Microsoft Office."
                           FontSize="10"
                           Foreground="#374151"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="69" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="White"
                            BorderBrush="#D6DEE8"
                            BorderThickness="1"
                            CornerRadius="4">
                        <TextBox x:Name="txtFolderPath"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="9"
                                 Foreground="#374151"
                                 Padding="7,5,7,5"
                                 IsReadOnly="True"
                                 CaretBrush="Transparent"
                                 Focusable="False"
                                 IsTabStop="False"
                                 Cursor="Arrow"
                                 VerticalContentAlignment="Center"
                                 TextChanged="FolderPath_TextChanged"/>
                    </Border>

                    <Button x:Name="btnBrowse"
                            Grid.Column="2"
                            Content="Duyệt..."
                            FontSize="9"
                            Foreground="#1F2937"
                            Background="White"
                            BorderBrush="#D6DEE8"
                            BorderThickness="1"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Click="Browse_Click">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,7,0,0" VerticalAlignment="Center">
                    <TextBlock Text="✔" FontSize="8" Foreground="#22C55E" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtFreeSpace"
                               Text="Dung lượng trống: --"
                               FontSize="9"
                               Foreground="#374151"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Row="4"
                        Margin="0,9,0,0"
                        Padding="9,7,9,7"
                        Background="#EEF4FB"
                        BorderBrush="#D7E5F6"
                        BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Image Source="/Images/Office/info.png"
                                   Width="9"
                                   Height="9"
                                   Margin="0,0,4,0"
                                   VerticalAlignment="Center"/>
                            <TextBlock Text="Thông tin" FontSize="10" FontWeight="SemiBold" Foreground="#1F2937"/>
                        </StackPanel>
                        <TextBlock Text="Kích thước ước tính: ~3.2 GB (tùy phiên bản và ứng dụng)"
                                   FontSize="8.5"
                                   Foreground="#374151"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="Thời gian tải: Tùy thuộc vào tốc độ mạng"
                                   FontSize="8.5"
                                   Foreground="#374151"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="6" Margin="0,10,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="7" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnCancel"
                            Grid.Column="1"
                            Content="Hủy"
                            Height="27"
                            FontSize="11"
                            Foreground="#1F2937"
                            Background="#FFFFFF"
                            BorderBrush="#D6DEE8"
                            BorderThickness="1"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Click="Cancel_Click">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="btnConfirm"
                            Grid.Column="3"
                            Content="Bắt đầu tải xuống"
                            Height="27"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Background="#1D6FD8"
                            BorderThickness="0"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Click="Confirm_Click">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
    </Viewbox>
</Window>
