<Window x:Class="HyperLisUI.Views.Components.LicenseRestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Khôi phục bản quyền"
        Width="620" Height="450"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    
    <Grid>
        <!-- Bóng mờ viền ngoài -->
        <Border Margin="10" Background="White" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.15" Color="#000000"/>
            </Border.Effect>
        </Border>
        
        <!-- Nội dung chính -->
        <Border Margin="10" Background="White" CornerRadius="12" Padding="25">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="&#xE8B9;" FontFamily="pack://application:,,,/Resources/Fonts/#Fluent System Icons, pack://application:,,,/Resources/Fonts/#FluentSystemIcons-Regular" FontSize="20" Foreground="#0078D4" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblPopupRestoreTitle" Text="Khôi phục bản quyền" FontSize="16" FontWeight="SemiBold" Foreground="#1E1E1E" VerticalAlignment="Center"/>
                </StackPanel>
                
                <TextBlock x:Name="lblPopupRestoreSubTitle" Grid.Row="1" Text="Chọn một bản sao lưu để khôi phục cho máy tính này:" FontSize="14" Foreground="#333" Margin="0,0,0,10"/>
                
                <Border Grid.Row="2" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="6" Background="#F9F9F9" Margin="0,0,0,15">
                    <ListView x:Name="lvBackups" Background="Transparent" BorderThickness="0" Margin="5" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F0F6FF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#E0EFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Grid.Column="0" Text="&#xE740;" FontFamily="pack://application:,,,/Resources/Fonts/#Fluent System Icons, pack://application:,,,/Resources/Fonts/#FluentSystemIcons-Regular" FontSize="24" Foreground="#0078D4" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                    
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" Foreground="#1E1E1E"/>
                                        <TextBlock Text="{Binding DateString}" FontSize="12" Foreground="#666" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding BackupPath}" FontSize="11" Foreground="#999" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
                
                <Grid Grid.Row="3" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock x:Name="lblPopupRestoreNotFound" Text="Không tìm thấy bản sao lưu? Duyệt từ USB hoặc ổ đĩa khác:" FontSize="13" Foreground="#666" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
                    <Button x:Name="btnBrowse" Grid.Column="1" Background="White" BorderBrush="#E5E5E5" BorderThickness="1" Padding="15,6" Foreground="#333" Click="Browse_Click" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="pack://application:,,,/Resources/Fonts/#Fluent System Icons, pack://application:,,,/Resources/Fonts/#FluentSystemIcons-Regular" Margin="0,0,6,0" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblPopupRestoreBrowse" Text="Duyệt thư mục..." VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
                
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnRestore" Content="Khôi phục" Background="#0078D4" Foreground="White" BorderThickness="0" Padding="25,8" Margin="0,0,10,0" FontWeight="SemiBold" Cursor="Hand" Click="BtnRestore_Click" IsEnabled="False">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="btnCancel" Content="Hủy" Background="White" Foreground="#333" BorderBrush="#E5E5E5" BorderThickness="1" Padding="25,8" Cursor="Hand" Click="BtnCancel_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
