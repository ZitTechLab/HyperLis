<Window x:Class="HyperLisUI.Views.Components.CustomMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Message" 
        Width="580" 
        MinWidth="520" 
        MaxWidth="680"
        MinHeight="240"
        MaxHeight="580"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Grid Margin="15">
        <!-- Shadow Effect -->
        <Border Background="#E6F4F9" CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.25" Color="#222"/>
            </Border.Effect>
        </Border>

        <!-- Main Content -->
        <Border Background="#E6F4F9" CornerRadius="16" Padding="28" BorderBrush="#BCE0F0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title -->
                    <RowDefinition Height="*"/>    <!-- Content -->
                    <RowDefinition Height="Auto"/> <!-- Button -->
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock x:Name="TitleText" 
                           Text="Info" 
                           FontSize="18" 
                           FontWeight="SemiBold" 
                           Foreground="#222" 
                           TextWrapping="Wrap"
                           HorizontalAlignment="Left" 
                           Margin="0,0,0,16"/>

                <!-- Message Content with ScrollViewer -->
                <ScrollViewer Grid.Row="1" 
                              VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="380"
                              Margin="0,0,0,20">
                    <TextBlock x:Name="MessageText" 
                               Text="Select Extend Features if you want to install Microsoft Office." 
                               FontSize="14" 
                               LineHeight="22"
                               Foreground="#333" 
                               TextWrapping="Wrap" 
                               HorizontalAlignment="Stretch" 
                               VerticalAlignment="Center"/>
                </ScrollViewer>

                <!-- Button -->
                <Button x:Name="OkButton" 
                        Grid.Row="2" 
                        Content="Got it" 
                        MinWidth="140" 
                        Height="42" 
                        Foreground="#1A3B4D"
                        Background="#87CEEB" 
                        BorderThickness="0"
                        HorizontalAlignment="Center" 
                        Cursor="Hand"
                        FocusVisualStyle="{x:Null}"
                        Click="OkButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                             <Setter Property="CornerRadius" Value="21"/>
                        </Style>
                    </Button.Resources>
                    <Button.Template>
                         <ControlTemplate TargetType="Button">
                             <Border Background="{TemplateBinding Background}" CornerRadius="21">
                                 <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontWeight="Medium" TextElement.FontSize="15"/>
                             </Border>
                         </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
