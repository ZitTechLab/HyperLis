<UserControl x:Class="HyperLisUI.Views.USBBootDescriptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="300">
    <StackPanel>
        <TextBlock Text="Description:" FontWeight="SemiBold" FontSize="19" Margin="0,0,0,15" Foreground="#333"/>
        <TextBlock Text="Pick your USB, choose Windows, and let us do the magic. In minutes, you'll get a Multi-Boot USB that installs Windows and carries everything you need." 
                   TextWrapping="Wrap" FontSize="17" LineHeight="22" Margin="0,0,0,25" Foreground="#333"/>
        
        <!-- <Separator Background="#A0A0A0" Margin="0,0,0,20"/> -->
        <Separator Background="White" Opacity="0.5" Margin="0,10"/>
        <TextBlock Text="Mô tả:" FontWeight="SemiBold" FontSize="19" Margin="0,0,0,15" Foreground="#333"/>
        <TextBlock Text="Chọn USB và chọn phiên bản Windows yêu thích, chờ 1 lát và bạn sẽ được 1 chiếc USB có thể chứa được nhiều ISO Windows khác nhau, ngoài ra nó còn có thể chứa dữ liệu hay bất cứ thứ gì bạn muốn" 
                   TextWrapping="Wrap" FontSize="17" LineHeight="22" Foreground="#333"/>
    </StackPanel>
</UserControl>
