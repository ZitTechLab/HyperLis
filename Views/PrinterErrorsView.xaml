<UserControl x:Class="HyperLisUI.Views.PrinterErrorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:HyperLisUI.Views.Components">
    
    <Grid Margin="-10,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <components:LoadingOverlayView x:Name="LoadingOverlay" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="10"/>

        <Border Grid.Row="0" Background="#40FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock x:Name="TextTitle" Text="Fix LAN Printer Sharing" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#222"/>
                <TextBlock x:Name="TextDesc" Text="This tool helps you fix common LAN printer sharing errors (such as 0x0000011b, 0x00000709) and automatically restarts the Print Spooler." FontSize="14" TextWrapping="Wrap" Foreground="#444" Margin="0,0,0,15"/>
                
                <TextBlock x:Name="TextSelectError" Text="Select your error symptom:" FontSize="13" Foreground="#666" Margin="0,0,0,5" FontWeight="Medium"/>
                <ComboBox x:Name="ComboErrorSelector" Style="{StaticResource WinUIComboBoxStyle}" Width="300" HorizontalAlignment="Left" Margin="0,0,0,15">
                    <!-- Will be populated from code-behind -->
                </ComboBox>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <Button x:Name="BtnStartFix" Content="Start Fix" Style="{StaticResource ActionButtonStyle}" Click="BtnStartFix_Click" Background="#A078C0E0" Padding="15,12" Width="Auto" MinWidth="160" FontSize="15" Margin="0,0,10,0"/>
                    <Button x:Name="BtnUninstallDrivers" Content="Uninstall Printer Drivers" Style="{StaticResource ActionButtonStyle}" Click="BtnUninstallDrivers_Click" Background="#A078C0E0" Padding="15,12" Width="Auto" MinWidth="160" FontSize="15" Margin="0,0,10,0"/>
                    <Button x:Name="BtnPrintManagement" Content="Print Management" Style="{StaticResource ActionButtonStyle}" Click="BtnPrintManagement_Click" Background="#A078C0E0" Padding="15,12" Width="Auto" MinWidth="160" FontSize="15" Margin="0,0,10,0"/>
                    <Button x:Name="BtnAddPrinter" Content="Add Printer" Style="{StaticResource ActionButtonStyle}" Click="BtnAddPrinter_Click" Background="#A078C0E0" Padding="15,12" Width="Auto" MinWidth="140" FontSize="15" Margin="0,0,10,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
        
        <Border Grid.Row="1" Background="#40FFFFFF" CornerRadius="12" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="TextLogLabel" Text="Execution Logs:" FontSize="14" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,10"/>
                <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="LogList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Foreground="{Binding Color}" FontFamily="Consolas" FontSize="13" Margin="0,2" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
