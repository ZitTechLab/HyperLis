<Window x:Class="ConvertSKU.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Convert SKU Tool"
        MinWidth="860"
        MinHeight="600"
        Width="1050"
        Height="700"
        Background="#EEF2F7"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryText" Color="#0B1A3A" />
        <SolidColorBrush x:Key="SecondaryText" Color="#48638A" />
        <SolidColorBrush x:Key="CardBg" Color="#FCFCFE" />
        <SolidColorBrush x:Key="PanelBg" Color="#DEE5EF" />
        <SolidColorBrush x:Key="PrimaryNavy" Color="#0A1532" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="22" />
        </Style>

        <Style x:Key="VersionButtonStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" CornerRadius="14" BorderThickness="1.5" BorderBrush="#B6C4D8" Background="#FFFFFF" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontSize="20" FontWeight="Bold" Foreground="{TemplateBinding Foreground}" />
                                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,3,0,0" FontSize="13" Foreground="#5D769A" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#8899B5" />
                                <Setter TargetName="Root" Property="Background" Value="#F5F7FA" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#0A1532" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#0A1532" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="TextElement.Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditionButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#284B76" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" CornerRadius="12" BorderThickness="1.4" BorderBrush="#B8C6DB" Background="#FFFFFF" Padding="14,10">
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontSize="13" TextWrapping="Wrap" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#8899B5" />
                                <Setter TargetName="Root" Property="Background" Value="#F5F7FA" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#EAF1FF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#2B64EA" />
                                <Setter Property="Foreground" Value="#1D4ED8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConvertButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="12" Background="{StaticResource PrimaryNavy}" Padding="0,14" Cursor="Hand">
                            <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="White" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#162044" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#0D1228" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24" MaxWidth="1100" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel>
                    <Border Background="#FFFFFF" BorderBrush="#DCE5F0" BorderThickness="1" CornerRadius="8" Padding="14,8" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⊞" FontSize="11" Foreground="#64748B" Margin="0,0,6,0" />
                            <TextBlock Text="Tool Convert SKU Windows" FontSize="12" FontWeight="SemiBold" Foreground="#3F5C85" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Chuyển đổi phiên bản Windows nhanh chóng" FontSize="30" FontWeight="Bold" Foreground="{StaticResource PrimaryText}" Margin="0,10,0,0" />
                    <TextBlock Text="Kiểm tra phiên bản hiện tại, chọn Windows và Edition muốn chuyển, sau đó bắt đầu quá trình convert SKU." FontSize="13" Foreground="{StaticResource SecondaryText}" Margin="0,6,0,0" TextWrapping="Wrap" HorizontalAlignment="Left" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="1.35*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Phiên bản hiện tại" FontSize="12" Foreground="#5E769B" FontWeight="SemiBold" />
                                <TextBlock x:Name="CurrentVersionText" Text="..." FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryText}" Margin="0,5,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Width="40" Height="40" CornerRadius="12" Background="#EAF0F6">
                                <TextBlock Text="🛡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <Border Background="{StaticResource PanelBg}" CornerRadius="12" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Version" FontSize="13" Foreground="#5E769B"/><TextBlock x:Name="VersionValue" Grid.Column="1" Text="..." FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="1" Text="Build" Margin="0,8,0,0" FontSize="13" Foreground="#5E769B"/><TextBlock x:Name="BuildValue" Grid.Row="1" Grid.Column="1" Text="..." Margin="0,8,0,0" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="2" Text="Architecture" Margin="0,8,0,0" FontSize="13" Foreground="#5E769B"/><TextBlock x:Name="ArchValue" Grid.Row="2" Grid.Column="1" Text="..." Margin="0,8,0,0" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="3" Text="License status" Margin="0,8,0,0" FontSize="13" Foreground="#5E769B"/><TextBlock x:Name="LicenseValue" Grid.Row="3" Grid.Column="1" Text="..." Margin="0,8,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#047857"/>
                            </Grid>
                        </Border>

                        <Border Margin="0,16,0,0" BorderBrush="#F2C94C" BorderThickness="1" Background="#FAF6E8" CornerRadius="12" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="⚠" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="Lưu ý" FontSize="12.5" FontWeight="Bold" Foreground="#A24910" />
                                </StackPanel>
                                <TextBlock Text="Vui lòng lưu công việc đang mở trước khi bắt đầu. Một số thay đổi có thể yêu cầu khởi động lại máy." FontSize="12.5" Foreground="#A24910" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Thiết lập chuyển đổi" FontSize="12" Foreground="#5E769B" FontWeight="SemiBold" />
                        <TextBlock Text="Chọn SKU mục tiêu" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryText}" Margin="0,4,0,0" />

                        <TextBlock Text="1. Chọn phiên bản Windows" FontSize="14" FontWeight="Bold" Margin="0,18,0,8" />
                        <UniformGrid Columns="2" Rows="1">
                            <RadioButton x:Name="Win10Option" GroupName="WindowsVersion" Tag="Windows 10" Style="{StaticResource VersionButtonStyle}" Checked="WindowsOption_Checked" Margin="0,0,8,0"/>
                            <RadioButton x:Name="Win11Option" GroupName="WindowsVersion" Tag="Windows 11" Style="{StaticResource VersionButtonStyle}" Checked="WindowsOption_Checked" Margin="8,0,0,0"/>
                        </UniformGrid>

                        <TextBlock Text="2. Chọn Edition muốn chuyển" FontSize="14" FontWeight="Bold" Margin="0,18,0,8" />
                        <!-- Hàng 1: Home -->
                        <TextBlock Text="Home" FontSize="11" Foreground="#8899B5" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <UniformGrid Columns="2" Rows="1" Margin="0,0,0,10">
                            <RadioButton GroupName="TargetEdition" Content="Home" Style="{StaticResource EditionButtonStyle}" Checked="EditionOption_Checked" Margin="0,0,4,0" />
                            <RadioButton GroupName="TargetEdition" Content="Home Single Language" Style="{StaticResource EditionButtonStyle}" Checked="EditionOption_Checked" Margin="4,0,0,0" />
                        </UniformGrid>
                        <!-- Hàng 2: Pro -->
                        <TextBlock Text="Pro" FontSize="11" Foreground="#8899B5" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <UniformGrid Columns="2" Rows="2" Margin="0,0,0,10">
                            <RadioButton GroupName="TargetEdition" Content="Pro" Style="{StaticResource EditionButtonStyle}" Checked="EditionOption_Checked" Margin="0,0,4,6" />
                            <RadioButton GroupName="TargetEdition" Content="Pro for Workstations" Style="{StaticResource EditionButtonStyle}" Checked="EditionOption_Checked" Margin="4,0,0,6" />
                            <RadioButton GroupName="TargetEdition" Content="Pro Education" Style="{StaticResource EditionButtonStyle}" Checked="EditionOption_Checked" Margin="0,0,4,0" />
                            <RadioButton GroupName="TargetEdition" Content="Pro Single Language" Style="{StaticResource EditionButtonStyle}" Checked="EditionOption_Checked" Margin="4,0,0,0" />
                        </UniformGrid>
                        <!-- Hàng 3: Education -->
                        <TextBlock Text="Education" FontSize="11" Foreground="#8899B5" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <UniformGrid Columns="2" Rows="1" Margin="0,0,0,10">
                            <RadioButton GroupName="TargetEdition" Content="Education" Style="{StaticResource EditionButtonStyle}" Checked="EditionOption_Checked" Margin="0,0,4,0" />
                            <Border Margin="4,0,0,0" />
                        </UniformGrid>
                        <!-- Hàng 4: Enterprise -->
                        <TextBlock Text="Enterprise" FontSize="11" Foreground="#8899B5" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <UniformGrid Columns="2" Rows="1">
                            <RadioButton GroupName="TargetEdition" Content="Enterprise" Style="{StaticResource EditionButtonStyle}" Checked="EditionOption_Checked" Margin="0,0,4,0" />
                            <RadioButton GroupName="TargetEdition" Content="IoT Enterprise" Style="{StaticResource EditionButtonStyle}" Checked="EditionOption_Checked" Margin="4,0,0,0" />
                        </UniformGrid>

                        <Border Margin="0,18,0,0" Background="#E3E9F1" CornerRadius="12" Padding="14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ⓘ" FontSize="14" Margin="0,0,8,0" Foreground="#243E65" />
                                <StackPanel>
                                    <TextBlock Text="Tóm tắt chuyển đổi" FontSize="14" FontWeight="Bold" Foreground="#243E65" />
                                    <TextBlock x:Name="SummaryText" FontSize="12.5" Margin="0,4,0,0" Foreground="#2E4E79" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Button x:Name="ConvertButton" Margin="0,18,0,0" Style="{StaticResource ConvertButtonStyle}" Content="▷  Bắt đầu convert SKU" Click="ConvertButton_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>

    <!-- Progress Overlay -->
    <Grid x:Name="ProgressOverlay" Visibility="Collapsed" Background="#DD0A1532">
        <Border MaxWidth="700" MaxHeight="520" CornerRadius="18" Background="#FCFCFE" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="⛔ Đang chuyển đổi SKU..." FontSize="20" FontWeight="Bold" Foreground="#0B1A3A" />
                    <TextBlock Text="Vui lòng không tắt máy trong quá trình này." FontSize="12" Foreground="#5E769B" Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Row="1" Background="#0D1228" CornerRadius="10" Padding="16">
                    <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12" Foreground="#B8D0F0" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button x:Name="CloseLogButton" Visibility="Collapsed" Content="✖  Đóng" Click="CloseLog_Click" Padding="20,10" Background="#E3E9F1" Foreground="#243E65" FontWeight="SemiBold" BorderThickness="0" Margin="0,0,10,0" />
                    <Button x:Name="RestartButton" Visibility="Collapsed" Content="🔄  Khởi động lại" Click="RestartPC_Click" Style="{StaticResource ConvertButtonStyle}" Padding="20,10" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </Grid>
</Window>